# Django Configuration
DJANGO_SECRET_KEY=your-super-secret-key-for-django
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ENVIRONMENT=development

# Database Configuration (PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pitchpal

# External APIs
GEMINI_API_KEY=your-gemini-api-key-1,your-gemini-api-key-2
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.5-flash

# Free fallback used for interview question generation/evaluation if all Gemini
# models fail (e.g. outage or quota exhaustion). Get a free key at console.groq.com
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# File Uploads
OCR_MAX_FILE_SIZE=10485760
