# Django Configuration
DJANGO_SECRET_KEY=your-super-secret-key-for-django
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ENVIRONMENT=development

# Database Configuration (PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pitchpal

# External APIs
# Comma-separated keys are tried in order for each model below (rotation on
# rate-limit/auth/availability errors). Comma-separated models are tried in
# order, each against every key, before falling back to hardcoded defaults.
GEMINI_API_KEY=your-gemini-api-key-1,your-gemini-api-key-2
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash

# File Uploads
OCR_MAX_FILE_SIZE=10485760
